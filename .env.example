# Copy this file to .env (which is gitignored) and fill in your project's
# values from Supabase Dashboard → Project Settings → API.
# Run the app with:
#   flutter run --dart-define=SUPABASE_URL=$SUPABASE_URL --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
# or source this file's values into your shell first.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
